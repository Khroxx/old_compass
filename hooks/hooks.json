{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'),'hooks/session-start.js')).main()\"",
            "timeout": 15,
            "statusMessage": "Grandpa is putting on his glasses..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'),'hooks/prompt.js')).main()\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|Bash|shell|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT).split(String.fromCharCode(92)).join('/'),'hooks/guard.js')).main()\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}